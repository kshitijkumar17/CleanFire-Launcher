<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.karat.materialhome">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34" />

    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Keyless IP geolocation and Open-Meteo weather; Android location is only for the optional Wi-Fi SSID. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Optional: Android 11 treats the connected Wi-Fi SSID as location-sensitive. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility: only apps with a TV or phone launcher entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
    </queries>

    <!-- Per-app screen time, read on the TV only, to order the dock by use (optional user-granted access). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/cleanfire_icon"
        android:banner="@drawable/cleanfire_banner"
        android:allowBackup="false"
        android:theme="@style/HomeTheme">

        <activity
            android:name="com.rampey.materialtv.HomeActivity"
            android:label="@string/app_name"
            android:icon="@drawable/cleanfire_icon"
            android:banner="@drawable/cleanfire_banner"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The screensaver: clock, date, the drifting shape, colors that glide between Material palettes. -->
        <service
            android:name="com.rampey.materialtv.Screensaver"
            android:exported="true"
            android:label="@string/screensaver_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- No Home interception: existing Fire TV Home routing remains in control. -->
    </application>
</manifest>
